<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Mitzh.Invoice.Api</AssemblyName>
    <PackageId>Mitzh.Invoice.Api</PackageId>
    <Description>Offline invoice recognition HTTP API with Swagger, distributed as a .NET tool.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mitzh-invoice-api</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mitzh.Invoice.Core" Version="3.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY.md" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" Link="THIRD-PARTY.md" />
    <None Include="../../samples/einvoice.xml" Link="samples/einvoice.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../models/**/*" Link="models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../docs/licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Update="appsettings*.json" Pack="false" />
  </ItemGroup>
  <Target Name="ExcludeMobileNativeAssets" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('/%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').Contains('/runtimes/ios/')) Or $([System.String]::Copy('/%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').Contains('/runtimes/android/'))" />
    </ItemGroup>
  </Target>
</Project>